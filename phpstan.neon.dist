includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - config
        - routes
    tmpDir: build/phpstan
    ignoreErrors:
        # This is the package's config file: it is published into the host
        # application's config directory, where env() calls are the norm.
        # Larastan only recognises the application's own config path.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/mail-dashboard.php
        # The "mail-dashboard::" view namespace is registered at runtime by
        # the service provider, so Larastan cannot resolve it statically.
        -
            message: '#Parameter \#1 \$view of function view expects view-string#'
            path: src/Http/Controllers/DashboardController.php
            reportUnmatched: false
